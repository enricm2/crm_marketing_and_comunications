<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Origen propio, distinto del "LinkedIn" genérico de utm: permite
             filtrar en el CRM solo lo que ha entrado por el minero de red,
             sin mezclarlo con campañas o formularios web etiquetados a mano. -->
        <record id="utm_source_linkedin_signal" model="utm.source">
            <field name="name">LinkedIn Signal</field>
        </record>

        <!-- Parámetros de conexión con n8n.

             Van aquí y no solo como `default` del campo de Ajustes porque un
             `config_parameter` no existe en la base hasta que alguien abre y
             guarda la página de Ajustes: sin esto, los webhooks salientes no
             harían nada tras instalar, en silencio y sin error visible.
             noupdate="1" garantiza que actualizar el módulo no pise lo que se
             haya cambiado desde la interfaz.

             El aviso de señal caliente NO se siembra a propósito: sin ruta,
             Odoo no llama a n8n para eso. Ya avisa él por chatter y WhatsApp,
             y el flujo del minero de red suele tener su propio nodo de
             notificación; activar los dos daría dos avisos por señal. -->
        <record id="config_linkedin_n8n_base_url" model="ir.config_parameter">
            <field name="key">crm_marketing_and_comunications.linkedin_n8n_base_url</field>
            <field name="value">https://n8n.uniasser.net</field>
        </record>
        <record id="config_linkedin_webhook_call_prep" model="ir.config_parameter">
            <field name="key">crm_marketing_and_comunications.linkedin_webhook_call_prep</field>
            <field name="value">/webhook/ventas-ligero</field>
        </record>
        <record id="config_linkedin_webhook_router" model="ir.config_parameter">
            <field name="key">crm_marketing_and_comunications.linkedin_webhook_router</field>
            <field name="value">/webhook/router-embudo</field>
        </record>
        <record id="config_linkedin_webhook_ping" model="ir.config_parameter">
            <field name="key">crm_marketing_and_comunications.linkedin_webhook_ping</field>
            <field name="value">/webhook/vantis-ping</field>
        </record>

        <record id="seq_linkedin_batch" model="ir.sequence">
            <field name="name">Lotes de señales de LinkedIn</field>
            <field name="code">marketing.linkedin.batch</field>
            <field name="prefix">LI-LOTE-%(year)s-</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Etiquetas de CRM por tipo de señal. El código las crea bajo demanda
             si faltan, pero declararlas aquí evita que se creen con nombres
             distintos según quién procese la primera señal de cada tipo. -->
        <record id="crm_tag_linkedin_comment" model="crm.tag">
            <field name="name">LinkedIn: Comentario</field>
        </record>
        <record id="crm_tag_linkedin_reaction" model="crm.tag">
            <field name="name">LinkedIn: Reacción / Like</field>
        </record>
        <record id="crm_tag_linkedin_profile_view" model="crm.tag">
            <field name="name">LinkedIn: Vista de perfil</field>
        </record>
        <record id="crm_tag_linkedin_connection" model="crm.tag">
            <field name="name">LinkedIn: Nueva conexión</field>
        </record>
        <record id="crm_tag_linkedin_message" model="crm.tag">
            <field name="name">LinkedIn: Mensaje directo</field>
        </record>

    </data>
</odoo>
