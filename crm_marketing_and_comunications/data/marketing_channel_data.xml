<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="channel_email" model="marketing.channel">
            <field name="name">Email Marketing</field>
            <field name="code">email</field>
            <field name="sequence">10</field>
            <field name="available">True</field>
            <field name="color">4</field>
        </record>

        <record id="channel_whatsapp" model="marketing.channel">
            <field name="name">WhatsApp Business</field>
            <field name="code">whatsapp</field>
            <field name="sequence">20</field>
            <field name="available">True</field>
            <field name="color">10</field>
        </record>

        <record id="channel_linkedin" model="marketing.channel">
            <field name="name">LinkedIn (Prosp)</field>
            <field name="code">linkedin</field>
            <field name="sequence">25</field>
            <field name="available">True</field>
            <field name="color">7</field>
        </record>

        <record id="channel_meta" model="marketing.channel">
            <field name="name">Meta Ads</field>
            <field name="code">meta</field>
            <field name="sequence">30</field>
            <field name="available">False</field>
            <field name="coming_soon_note">Próximamente — integración con Meta Ads en desarrollo</field>
            <field name="color">1</field>
        </record>

        <record id="seq_marketing_campaign" model="ir.sequence">
            <field name="name">Secuencia campaña marketing</field>
            <field name="code">marketing.campaign</field>
            <field name="prefix">CAMP-%(year)s-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>
    </data>

    <!-- Templates públicos para la página de baja -->
    <template id="unsubscribe_success" name="Baja procesada correctamente">
        <t t-call="web.layout">
            <t t-set="head_website">
                <style>
                    body { font-family: Arial, sans-serif; background: #f5f5f5; }
                    .container { max-width: 500px; margin: 80px auto; background: #fff;
                                 padding: 40px; border-radius: 8px; text-align: center; }
                    h2 { color: #1A3A5C; }
                    .check { font-size: 48px; color: #2ECC71; margin-bottom: 20px; }
                    p { color: #555; line-height: 1.6; }
                </style>
            </t>
            <div class="container">
                <div class="check">✓</div>
                <h2>Baja procesada</h2>
                <p>Tu solicitud de baja ha sido registrada correctamente.</p>
                <p>No volverás a recibir comunicaciones comerciales de <strong>Uniasser Consulting</strong>.</p>
                <p style="font-size:0.85rem;color:#999;margin-top:30px;">
                    Si crees que esto es un error, puedes contactarnos en
                    <a href="mailto:enric@uniasser.com">enric@uniasser.com</a>
                </p>
            </div>
        </t>
    </template>

    <template id="unsubscribe_invalid" name="Token de baja no válido">
        <t t-call="web.layout">
            <t t-set="head_website">
                <style>
                    body { font-family: Arial, sans-serif; background: #f5f5f5; }
                    .container { max-width: 500px; margin: 80px auto; background: #fff;
                                 padding: 40px; border-radius: 8px; text-align: center; }
                    h2 { color: #dc3545; }
                    p { color: #555; line-height: 1.6; }
                </style>
            </t>
            <div class="container">
                <h2>Enlace no válido</h2>
                <p>El enlace de baja no es válido o ya fue procesado anteriormente.</p>
                <p>Si deseas darte de baja, contacta directamente con
                    <a href="mailto:enric@uniasser.com">enric@uniasser.com</a>
                </p>
            </div>
        </t>
    </template>
</odoo>
