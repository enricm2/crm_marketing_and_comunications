<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_marketing_template_import_form" model="ir.ui.view">
        <field name="name">marketing.template.import.form</field>
        <field name="model">marketing.template.import</field>
        <field name="arch" type="xml">
            <form string="Importar plantilla">
                <field name="campaign_id" invisible="1"/>
                <group>
                    <field name="canal" widget="radio"/>
                    <field name="origen" widget="radio"/>
                    <field name="source_template_id"
                        invisible="origen != 'copy'"
                        required="origen == 'copy'"
                        domain="[('channel','=',canal)]"
                        options="{'no_create': True}"/>
                    <field name="source_crm_template_id"
                        invisible="origen != 'crm'"
                        required="origen == 'crm'"
                        options="{'no_create': True}"/>
                </group>
                <div class="alert alert-info" role="alert">
                    <field name="aviso" nolabel="1" readonly="1"/>
                </div>
                <footer>
                    <button name="action_importar" type="object"
                            string="Importar" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
