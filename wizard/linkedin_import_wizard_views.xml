<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_linkedin_import_wizard_form" model="ir.ui.view">
        <field name="name">linkedin.import.wizard.form</field>
        <field name="model">linkedin.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar señales de LinkedIn">
                <!-- UN SOLO footer, hijo directo del form.

                     Con un footer por estado, Odoo los sube los dos al pie del
                     diálogo y las condiciones del <div> que los contenía dejan
                     de aplicarse: los botones del resultado quedaban pulsables
                     ya en la pantalla de selección, cuando todavía no hay lote.
                     La condición va en cada botón. -->
                <field name="state" invisible="1"/>
                <field name="batch_id" invisible="1"/>
                <field name="csv_filename" invisible="1"/>

                <div invisible="state != 'choose'">
                    <group>
                        <group>
                            <field name="profile_id" options="{'no_create': True}"/>
                            <field name="input_mode" widget="radio"/>
                        </group>
                        <group>
                            <field name="default_signal_type"
                                required="input_mode == 'text'"/>
                            <field name="post_id" options="{'no_create': True}"/>
                            <field name="delimiter" invisible="input_mode != 'file'"/>
                        </group>
                    </group>

                    <div invisible="input_mode != 'file'">
                        <div class="alert alert-info" role="alert">
                            Vale la exportación de "quién ha visto tu perfil" de
                            Sales Navigator o tu copia de datos de LinkedIn
                            (<code>Connections.csv</code>). Si el fichero no trae
                            columna de tipo —lo habitual—, rellena
                            <b>Tipo de señal del fichero</b>.
                            <b>Reimportar es inocuo</b>: no duplica ni infla puntuaciones.
                        </div>
                        <group>
                            <field name="csv_file" filename="csv_filename"
                                widget="binary" required="input_mode == 'file'"/>
                        </group>
                    </div>

                    <div invisible="input_mode != 'text'">
                        <div class="alert alert-info" role="alert">
                            <b>LinkedIn no exporta quién comenta o reacciona a una
                            publicación</b>: la analítica descargable trae totales, no
                            personas. Abre la lista de reacciones (o la sección de
                            comentarios), selecciónala entera y pégala aquí tal cual —
                            con nombres repetidos, «· 2º», «Me gusta» y lo que venga.
                            Se limpia y <b>se muestra para que lo revises</b> antes de
                            tocar el CRM.
                        </div>
                        <field name="raw_text" nolabel="1" widget="text"
                            placeholder="Pega aquí lo copiado de LinkedIn…"/>
                    </div>
                </div>

                <div invisible="state != 'review'">
                    <div class="alert alert-warning" role="alert">
                        <b>Revisa antes de importar.</b> Puedes corregir cualquier
                        celda, rellenar el tipo de señal que falte y desmarcar las
                        filas que no sean un contacto. Las filas sin nombre o sin
                        tipo simplemente no se importarán: no bloquean al resto.
                        <field name="skipped_note" nolabel="1" readonly="1" class="d-block mt4"/>
                    </div>
                    <group>
                        <field name="default_signal_type"
                            string="Tipo general (se aplica a las filas sin tipo)"/>
                        <field name="post_id" options="{'no_create': True}"/>
                    </group>
                    <field name="line_ids" nolabel="1">
                        <list editable="bottom" create="1" delete="1">
                            <field name="include" widget="boolean_toggle"/>
                            <field name="contact_name"/>
                            <field name="signal_type"/>
                            <field name="job_title"/>
                            <field name="company_name"/>
                            <field name="signal_date" optional="show"/>
                            <field name="linkedin_url" optional="show"/>
                            <field name="comment_text" optional="show"/>
                            <field name="source_line" optional="hide" readonly="1"/>
                        </list>
                    </field>
                </div>

                <div invisible="state != 'done'">
                    <field name="result_html" nolabel="1" readonly="1"/>
                </div>

                <footer>
                    <button name="action_import" type="object" string="Importar"
                        class="btn-primary"
                        invisible="state != 'choose' or input_mode != 'file'"/>
                    <button name="action_parse_text" type="object"
                        string="Leer el texto pegado" class="btn-primary"
                        invisible="state != 'choose' or input_mode != 'text'"/>
                    <button name="action_import" type="object"
                        string="Importar las marcadas" class="btn-primary"
                        invisible="state != 'review'"/>
                    <button name="action_back_to_choose" type="object"
                        string="Volver" class="btn-secondary"
                        invisible="state != 'review'"/>
                    <button name="action_view_signals" type="object"
                        string="Ver señales importadas" class="btn-primary"
                        invisible="state != 'done' or not batch_id"/>
                    <button name="action_import_another" type="object"
                        string="Importar otro fichero" class="btn-secondary"
                        invisible="state != 'done'"/>
                    <!-- Sin condición: siempre tiene que haber una salida del
                         diálogo, pase lo que pase con los datos. -->
                    <button string="Cancelar" class="btn-secondary" special="cancel"
                        invisible="state == 'done'"/>
                    <button string="Cerrar" class="btn-secondary" special="cancel"
                        invisible="state != 'done'"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_linkedin_import_wizard" model="ir.actions.act_window">
        <field name="name">Importar CSV de LinkedIn</field>
        <field name="res_model">linkedin.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
