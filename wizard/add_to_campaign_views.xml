<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_add_to_campaign_form" model="ir.ui.view">
        <field name="name">marketing.add.to.campaign.form</field>
        <field name="model">marketing.add.to.campaign</field>
        <field name="arch" type="xml">
            <form string="Añadir a campaña">
                <field name="lead_ids" invisible="1"/>
                <field name="total_seleccionados" invisible="1"/>
                <field name="n_validos" invisible="1"/>
                <field name="n_sin_email" invisible="1"/>
                <field name="n_excluidos" invisible="1"/>
                <field name="n_ya_estan" invisible="1"/>

                <group>
                    <field name="modo" widget="radio"/>
                    <field name="campaign_id"
                           invisible="modo != 'existente'"
                           required="modo == 'existente'"
                           options="{'no_create_edit': True}"/>
                </group>

                <group string="Datos de la campaña nueva" invisible="modo != 'nueva'">
                    <field name="nombre_nueva" required="modo == 'nueva'"
                           placeholder="Ej.: Agencias de marketing — Valencia Q4"/>
                    <field name="service_nueva" options="{'no_create_edit': True}"/>
                    <field name="purpose_nueva"
                           placeholder="Qué quieres conseguir. Lo usa la IA para redactar."/>
                    <field name="target_nueva"
                           placeholder="A quién te diriges: sector, tamaño, rol del decisor."/>
                </group>

                <div class="alert alert-info" role="alert">
                    <field name="resumen" nolabel="1" readonly="1"/>
                </div>

                <footer>
                    <button name="action_anadir" type="object"
                            string="Añadir a la campaña"
                            class="btn-primary"
                            invisible="n_validos == 0"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Acción en el menú "Acciones" de la lista de leads -->
    <record id="action_add_leads_to_campaign" model="ir.actions.server">
        <field name="name">Añadir a campaña</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="binding_model_id" ref="crm.model_crm_lead"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">
if records:
    action = {
        'type': 'ir.actions.act_window',
        'name': 'Añadir a campaña',
        'res_model': 'marketing.add.to.campaign',
        'view_mode': 'form',
        'target': 'new',
        'context': {'default_lead_ids': [(6, 0, records.ids)]},
    }
        </field>
    </record>

</odoo>
