<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_whatsapp_user" model="res.groups">
        <field name="name">WhatsApp / Usuario</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_whatsapp_admin" model="res.groups">
        <field name="name">WhatsApp / Administrador</field>
        <field name="implied_ids" eval="[(4, ref('group_whatsapp_user'))]"/>
    </record>

    <!-- Multi-company: mensajes solo de la propia empresa -->
    <record id="rule_wa_message_company" model="ir.rule">
        <field name="name">WhatsApp Message: acceso por empresa</field>
        <field name="model_id" ref="model_whatsapp_message"/>
        <field name="domain_force">[('account_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_whatsapp_user'))]"/>
    </record>

    <!-- Multi-company: cuentas solo de la propia empresa -->
    <record id="rule_wa_account_company" model="ir.rule">
        <field name="name">WhatsApp Account: acceso por empresa</field>
        <field name="model_id" ref="model_whatsapp_account"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_whatsapp_user'))]"/>
    </record>
</odoo>
