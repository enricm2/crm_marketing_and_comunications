<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── Action ── -->
    <record id="action_whatsapp_messages_list" model="ir.actions.act_window">
        <field name="name">Mensajes WhatsApp</field>
        <field name="res_model">whatsapp.message</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{'search_default_group_partner': 0}</field>
    </record>

    <!-- ── List view ── -->
    <record id="view_whatsapp_message_list" model="ir.ui.view">
        <field name="name">whatsapp.message.list</field>
        <field name="model">whatsapp.message</field>
        <field name="arch" type="xml">
            <list string="Mensajes WhatsApp"
                  default_order="timestamp desc"
                  decoration-success="direction == 'inbound'"
                  decoration-info="direction == 'outbound'"
                  decoration-danger="status == 'failed'">
                <field name="timestamp" widget="datetime" string="Fecha/Hora"/>
                <field name="direction"
                       widget="badge"
                       decoration-success="direction == 'inbound'"
                       decoration-info="direction == 'outbound'"/>
                <field name="partner_id" string="Contacto"/>
                <field name="lead_id" string="Lead" optional="show"/>
                <field name="account_id" optional="hide"/>
                <field name="message_type"/>
                <field name="body" string="Mensaje"/>
                <field name="status"
                       widget="badge"
                       decoration-success="status == 'read'"
                       decoration-info="status in ('sent', 'delivered')"
                       decoration-warning="status == 'pending'"
                       decoration-danger="status == 'failed'"/>
                <field name="phone" optional="hide"/>
                <field name="error_message" optional="hide" string="Error"/>
            </list>
        </field>
    </record>

    <!-- ── Form view ── -->
    <record id="view_whatsapp_message_form" model="ir.ui.view">
        <field name="name">whatsapp.message.form</field>
        <field name="model">whatsapp.message</field>
        <field name="arch" type="xml">
            <form string="Mensaje WhatsApp" create="false">
                <sheet>
                    <group>
                        <group string="Origen / Destino">
                            <field name="account_id" readonly="1"/>
                            <field name="direction" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="lead_id" readonly="1"/>
                            <field name="phone" readonly="1"/>
                        </group>
                        <group string="Estado del mensaje">
                            <field name="timestamp" readonly="1" widget="datetime"/>
                            <field name="message_type" readonly="1"/>
                            <field name="status"
                                   readonly="1"
                                   widget="badge"
                                   decoration-success="status == 'read'"
                                   decoration-info="status in ('sent', 'delivered')"
                                   decoration-warning="status == 'pending'"
                                   decoration-danger="status == 'failed'"/>
                            <field name="wa_message_id" readonly="1" string="ID Meta"/>
                            <field name="error_message" readonly="1"
                                   invisible="not error_message"
                                   class="text-danger"/>
                        </group>
                    </group>
                    <group string="Contenido">
                        <field name="body" readonly="1" nolabel="1" widget="text"/>
                    </group>
                    <group string="Adjuntos" invisible="not attachment_ids">
                        <field name="attachment_ids" readonly="1" nolabel="1"
                               widget="many2many_binary"/>
                    </group>
                    <group string="Plantilla" invisible="not template_id">
                        <field name="template_id" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Search view ── -->
    <record id="view_whatsapp_message_search" model="ir.ui.view">
        <field name="name">whatsapp.message.search</field>
        <field name="model">whatsapp.message</field>
        <field name="arch" type="xml">
            <search string="Buscar mensajes WhatsApp">
                <field name="body" string="Mensaje"/>
                <field name="partner_id" string="Contacto"/>
                <field name="lead_id" string="Lead"/>
                <field name="phone" string="Teléfono"/>
                <filter string="Recibidos" name="inbound"
                        domain="[('direction', '=', 'inbound')]"/>
                <filter string="Enviados" name="outbound"
                        domain="[('direction', '=', 'outbound')]"/>
                <separator/>
                <filter string="Fallidos" name="failed"
                        domain="[('status', '=', 'failed')]"/>
                <filter string="Leídos" name="read"
                        domain="[('status', '=', 'read')]"/>
                <separator/>
                <filter string="Hoy" name="today"
                        domain="[('timestamp', '>=', datetime.datetime.combine(context_today(), datetime.time(0,0,0)))]"/>
                <separator/>
                <filter string="Agrupar por Contacto" name="group_partner"
                        context="{'group_by': 'partner_id'}"/>
                <filter string="Agrupar por Cuenta" name="group_account"
                        context="{'group_by': 'account_id'}"/>
                <filter string="Agrupar por Fecha" name="group_date"
                        context="{'group_by': 'timestamp:day'}"/>
                <filter string="Agrupar por Estado" name="group_status"
                        context="{'group_by': 'status'}"/>
            </search>
        </field>
    </record>
</odoo>
