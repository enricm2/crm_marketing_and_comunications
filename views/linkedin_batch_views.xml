<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_linkedin_batch_form" model="ir.ui.view">
        <field name="name">marketing.linkedin.batch.form</field>
        <field name="model">marketing.linkedin.batch</field>
        <field name="arch" type="xml">
            <form string="Lote de ingesta">
                <header>
                    <button name="action_view_signals" type="object"
                        string="Ver señales" class="btn-primary"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="reference" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="profile_id"/>
                            <field name="source"/>
                            <field name="source_file"/>
                            <field name="executed_at"/>
                        </group>
                        <group>
                            <field name="received_count"/>
                            <field name="created_count"/>
                            <field name="duplicated_count"/>
                            <field name="ignored_count"/>
                            <field name="error_count"/>
                            <field name="hot_count"/>
                            <field name="leads_created_count"/>
                            <field name="leads_updated_count"/>
                        </group>
                    </group>
                    <group string="Filas que no se pudieron procesar"
                        invisible="not error_details">
                        <field name="error_details" nolabel="1" colspan="2" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_linkedin_batch_list" model="ir.ui.view">
        <field name="name">marketing.linkedin.batch.list</field>
        <field name="model">marketing.linkedin.batch</field>
        <field name="arch" type="xml">
            <list string="Lotes de ingesta"
                  decoration-danger="state == 'failed'"
                  decoration-warning="state == 'partial'">
                <field name="executed_at"/>
                <field name="reference"/>
                <field name="profile_id"/>
                <field name="source"/>
                <field name="source_file" optional="show"/>
                <field name="received_count" sum="Recibidas"/>
                <field name="created_count" sum="Nuevas"/>
                <field name="duplicated_count" sum="Duplicadas"/>
                <field name="ignored_count" sum="Ignoradas" optional="show"/>
                <field name="error_count" sum="Errores"/>
                <field name="leads_created_count" sum="Leads"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="action_linkedin_batch" model="ir.actions.act_window">
        <field name="name">Lotes de ingesta</field>
        <field name="res_model">marketing.linkedin.batch</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aún no ha entrado ninguna importación
            </p>
            <p>
                Cada llamada de n8n al endpoint de señales deja aquí su rastro:
                cuántas filas llegaron, cuántas eran nuevas y cuáles fallaron.
                Es el primer sitio donde mirar cuando una exportación no aparece.
            </p>
        </field>
    </record>

</odoo>
