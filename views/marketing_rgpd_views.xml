<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_marketing_rgpd_exclusion_form" model="ir.ui.view">
        <field name="name">marketing.rgpd.exclusion.form</field>
        <field name="model">marketing.rgpd.exclusion</field>
        <field name="arch" type="xml">
            <form string="Exclusión RGPD">
                <sheet>
                    <div class="alert alert-warning" role="alert">
                        <strong>Atención:</strong> Este contacto no puede recibir comunicaciones
                        de marketing por ningún canal. Esta exclusión aplica globalmente.
                    </div>
                    <group>
                        <group>
                            <field name="partner_email"/>
                            <field name="partner_phone"/>
                            <field name="reason"/>
                            <field name="excluded_by"/>
                        </group>
                        <group>
                            <field name="excluded_at"/>
                            <field name="lead_id"/>
                            <field name="campaign_id"/>
                        </group>
                    </group>
                    <group string="Notas">
                        <field name="notes" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_marketing_rgpd_exclusion_list" model="ir.ui.view">
        <field name="name">marketing.rgpd.exclusion.list</field>
        <field name="model">marketing.rgpd.exclusion</field>
        <field name="arch" type="xml">
            <list string="Lista de exclusión RGPD" create="1" delete="0"
                  decoration-danger="reason == 'unsubscribe_email'"
                  decoration-warning="reason == 'explicit_rejection'">
                <field name="partner_email"/>
                <field name="partner_phone"/>
                <field name="reason"/>
                <field name="excluded_by"/>
                <field name="excluded_at"/>
                <field name="lead_id"/>
                <field name="campaign_id"/>
            </list>
        </field>
    </record>

    <record id="action_marketing_rgpd_exclusion" model="ir.actions.act_window">
        <field name="name">Lista de exclusión RGPD</field>
        <field name="res_model">marketing.rgpd.exclusion</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay exclusiones RGPD registradas
            </p>
            <p>
                Los contactos que soliciten la baja o que rechacen explícitamente
                las comunicaciones se añaden automáticamente a esta lista.
            </p>
        </field>
    </record>
</odoo>
