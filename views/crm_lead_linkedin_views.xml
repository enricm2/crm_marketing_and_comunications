<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Patrón A: la acción que dispara la preparación de llamada.
         Se registra también como acción contextual de lista para poder
         preparar varias llamadas de una tacada antes de una mañana de teléfono. -->
    <record id="action_lead_prepare_call" model="ir.actions.server">
        <field name="name">Preparar llamada IA</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="binding_model_id" ref="crm.model_crm_lead"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
for record in records:
    record.action_prepare_call()
        </field>
    </record>

    <record id="crm_lead_view_form_linkedin" model="ir.ui.view">
        <field name="name">crm.lead.form.linkedin</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">

            <div name="button_box" position="inside">
                <button class="oe_stat_button" type="object"
                    name="action_view_linkedin_signals"
                    icon="fa-linkedin"
                    invisible="linkedin_signal_count == 0">
                    <field name="linkedin_signal_count" widget="statinfo"
                        string="Señales LinkedIn"/>
                </button>
            </div>

            <header position="inside">
                <button name="action_prepare_call" type="object"
                    string="Preparar llamada IA"
                    class="btn-secondary"
                    help="Genera contexto, objeciones probables y siguiente paso a partir de lo que ya hay en Odoo sobre este lead."/>
            </header>

            <notebook position="inside">
                <page string="LinkedIn" name="linkedin"
                    invisible="linkedin_signal_count == 0 and not x_linkedin_url">
                    <group>
                        <group string="Señales">
                            <field name="x_linkedin_url" widget="url"/>
                            <field name="x_linkedin_score"/>
                            <field name="x_linkedin_is_hot"/>
                            <field name="x_linkedin_is_excluded" invisible="1"/>
                            <field name="x_linkedin_excluded_by" readonly="1"
                                   invisible="not x_linkedin_excluded_by"/>
                            <field name="x_linkedin_exclusion_override"
                                   widget="boolean_toggle"
                                   invisible="not x_linkedin_excluded_by"
                                   help="Trata este lead como válido aunque encaje en una categoría de exclusión."/>
                            <field name="x_linkedin_last_signal_date"/>
                            <field name="x_linkedin_profile_id"/>
                        </group>
                    </group>
                    <field name="linkedin_signal_ids" nolabel="1" readonly="1">
                        <list>
                            <field name="signal_date"/>
                            <field name="signal_type"/>
                            <field name="post_id"/>
                            <field name="comment_text"/>
                            <field name="score"/>
                            <field name="icp_fit"/>
                        </list>
                    </field>
                </page>

                <page string="Preparación de llamada" name="call_prep">
                    <div class="alert alert-secondary text-center py-4" role="alert"
                        invisible="x_call_prep_state != 'none'">
                        <i class="fa fa-info-circle fs-3 d-block mb-2 text-muted"></i>
                        <h5>No hay preparación disponible</h5>
                        <p class="text-muted mb-0">Pulsa el botón <strong>"Preparar llamada IA"</strong> en la cabecera para generar el guión comercial, contexto y objeciones probables para este lead.</p>
                    </div>
                    <div class="alert alert-info" role="alert"
                        invisible="x_call_prep_state != 'pending'">
                        Preparación solicitada al flujo de n8n. El resultado aparecerá
                        aquí y en el chatter en cuanto responda.
                    </div>
                    <div class="alert alert-danger" role="alert"
                        invisible="x_call_prep_state != 'failed'">
                        La última preparación falló. Revisa la configuración de IA del
                        perfil de LinkedIn o la URL del webhook en Ajustes.
                    </div>
                    <group invisible="x_call_prep_state == 'none'">
                        <field name="x_call_prep_date" readonly="1"/>
                        <field name="x_call_prep_state" readonly="1"/>
                    </group>
                    <field name="x_call_prep" widget="html" nolabel="1" readonly="1" invisible="x_call_prep_state == 'none'"/>
                </page>
            </notebook>
        </field>
    </record>

    <!-- Lista de leads: la puntuación de LinkedIn como columna opcional,
         para poder ordenar por ella sin abrir cada ficha. -->
    <record id="crm_lead_view_list_linkedin" model="ir.ui.view">
        <field name="name">crm.lead.list.linkedin</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_leads"/>
        <field name="arch" type="xml">
            <field name="city" position="after">
                <field name="x_linkedin_score" optional="hide"/>
                <field name="x_linkedin_is_excluded" optional="hide" string="Excluido"/>
                <field name="x_linkedin_last_signal_date" optional="hide"/>
            </field>
        </field>
    </record>

    <!-- Acción para ver de un vistazo todo lo que ha entrado por LinkedIn. -->
    <record id="action_linkedin_leads" model="ir.actions.act_window">
        <field name="name">Leads desde LinkedIn</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('x_linkedin_score', '>', 0)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Todavía no hay leads con señales de LinkedIn
            </p>
            <p>
                En cuanto entren señales por el minero de red, los leads con
                puntuación aparecerán aquí ordenables por temperatura.
            </p>
        </field>
    </record>

    <!-- Filtros para seleccionar leads antes de añadirlos a una campaña.
         OJO: en una vista de búsqueda de Odoo 19 los <field> deben ir ANTES
         que los <filter>, por eso van con xpath separados. -->
    <record id="view_crm_lead_search_marketing" model="ir.ui.view">
        <field name="name">crm.lead.search.marketing</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_leads_filter"/>
        <field name="arch" type="xml">

            <xpath expr="//search/field[1]" position="after">
                <field name="function" string="Cargo (rol)"
                       filter_domain="[('function', 'ilike', self)]"/>
                <field name="x_linkedin_excluded_by" string="Categoría de exclusión"/>
            </xpath>

            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="mkt_score_alto" string="Puntuación alta (≥ 10)"
                        domain="[('x_linkedin_score', '&gt;=', 10)]"/>
                <filter name="mkt_score_medio" string="Puntuación media (5-9)"
                        domain="[('x_linkedin_score', '&gt;=', 5), ('x_linkedin_score', '&lt;', 10)]"/>
                <filter name="mkt_score_bajo" string="Puntuación baja (1-4)"
                        domain="[('x_linkedin_score', '&gt;=', 1), ('x_linkedin_score', '&lt;', 5)]"/>
                <separator/>
                <filter name="mkt_con_email" string="Con email"
                        domain="[('email_from', '!=', False), ('email_from', '!=', '')]"/>
                <filter name="mkt_no_excluidos" string="No excluidos"
                        domain="[('x_linkedin_is_excluded', '=', False)]"/>
                <filter name="mkt_excluidos" string="Excluidos por categoría"
                        domain="[('x_linkedin_is_excluded', '=', True)]"/>
                <separator/>
                <filter name="mkt_group_excluded" string="Categoría de exclusión"
                        context="{'group_by': 'x_linkedin_excluded_by'}"/>
                <filter name="mkt_group_function" string="Cargo"
                        context="{'group_by': 'function'}"/>
            </xpath>
        </field>
    </record>

</odoo>
