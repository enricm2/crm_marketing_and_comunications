<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form view para crm.communication (se abre en diálogo) -->
    <record id="crm_communication_view_form" model="ir.ui.view">
        <field name="name">crm.communication.form</field>
        <field name="model">crm.communication</field>
        <field name="arch" type="xml">
            <form string="Comunicación" class="o_crm_communication_form">
                <header>
                    <button string="Enviar email al cliente"
                            name="action_send_email"
                            type="object"
                            class="btn-primary"
                            invisible="action_type != 'email_sent' or email_sent_ok"/>
                    <button string="📱 Enviar WhatsApp"
                            name="action_send_whatsapp"
                            type="object"
                            class="btn-primary"
                            invisible="action_type != 'whatsapp_sent' or wa_sent_ok"/>
                    <field name="email_sent_ok" widget="statusbar"
                           statusbar_visible="True"
                           invisible="not email_sent_ok"/>
                    <field name="wa_sent_ok" widget="statusbar"
                           statusbar_visible="True"
                           invisible="not wa_sent_ok"/>
                </header>
                <sheet>
                    <group>
                        <group string="Información del contacto">
                            <field name="date"/>
                            <field name="action_type"/>
                            <field name="subject"/>
                            <field name="recipient_email"
                                   placeholder="email@cliente.com"
                                   readonly="email_sent_ok"
                                   invisible="action_type != 'email_sent'"/>
                        </group>
                        <group string="Participantes">
                            <field name="user_id"/>
                            <field name="partner_id"
                                   domain="[('id', 'in', (lead_partner_id.child_ids + lead_partner_id).ids)] if lead_partner_id else []"
                                   placeholder="Contacto del cliente..."/>
                            <field name="lead_partner_id" invisible="1"/>
                        </group>
                    </group>

                    <!-- Sección WhatsApp -->
                    <group string="WhatsApp"
                           invisible="action_type not in ('whatsapp_sent', 'whatsapp_received')">
                        <field name="wa_account_id"
                               required="action_type == 'whatsapp_sent'"
                               readonly="wa_sent_ok"/>
                        <field name="wa_send_mode"
                               widget="radio"
                               invisible="action_type != 'whatsapp_sent'"
                               readonly="wa_sent_ok"/>
                        <field name="wa_template_id"
                               domain="[('account_id', '=', wa_account_id), ('status', '=', 'approved')]"
                               options="{'no_create': True}"
                               invisible="wa_send_mode != 'template' or action_type != 'whatsapp_sent'"
                               required="action_type == 'whatsapp_sent' and wa_send_mode == 'template'"
                               readonly="wa_sent_ok"/>
                        <field name="wa_body"
                               widget="text"
                               placeholder="Mensaje de WhatsApp..."
                               invisible="wa_send_mode != 'text' or action_type != 'whatsapp_sent'"
                               required="action_type == 'whatsapp_sent' and wa_send_mode == 'text'"
                               readonly="wa_sent_ok"
                               colspan="2"/>
                    </group>

                    <!-- Plantilla visual: evita montar el email a mano -->
                    <group invisible="action_type != 'email_sent'">
                        <field name="email_template_id"
                               options="{'no_create_edit': True}"/>
                        <button name="action_apply_email_template"
                                type="object"
                                string="Reemplazar cuerpo por la plantilla"
                                class="btn-secondary"
                                icon="fa-paint-brush"
                                invisible="not email_template_id"
                                confirm="Se reemplazará el contenido actual del cuerpo por el de la plantilla. ¿Continuar?"
                                title="Solo hace falta si ya has escrito algo: al elegir plantilla con el cuerpo vacío se rellena solo."/>
                    </group>

                    <separator string="Descripción / Notas"
                               invisible="action_type in ('whatsapp_sent', 'whatsapp_received')"/>
                    <group col="1"
                           invisible="action_type in ('whatsapp_sent', 'whatsapp_received')">
                        <!-- OJO: en Odoo 19 el widget html NO acepta 'height'
                             (ver extractProps en html_editor/fields/html_field.js:381).
                             Se ignoraba en silencio; la altura va por CSS. -->
                        <field name="description"
                               widget="html"
                               nolabel="1"
                               class="o_crm_comm_body"/>
                    </group>
                    <separator string="Documentos adjuntos"
                               invisible="action_type in ('whatsapp_sent', 'whatsapp_received')"/>
                    <group col="1"
                           invisible="action_type in ('whatsapp_sent', 'whatsapp_received')">
                        <field name="attachment_ids"
                               widget="many2many_binary"
                               nolabel="1"
                               options="{'accepted_types': '.pdf,.doc,.docx,.ppt,.pptx,.xls,.xlsx'}"
                               invisible="action_type not in ('email_sent', 'document')"/>
                        <field name="attachment_ids"
                               widget="many2many_binary"
                               nolabel="1"
                               invisible="action_type in ('email_sent', 'document')"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List view para crm.communication -->
    <record id="crm_communication_view_list" model="ir.ui.view">
        <field name="name">crm.communication.list</field>
        <field name="model">crm.communication</field>
        <field name="arch" type="xml">
            <list string="Historial de comunicaciones"
                  decoration-info="action_type in ('note',)"
                  decoration-success="action_type in ('email_sent', 'email_received', 'whatsapp_sent', 'whatsapp_received')"
                  decoration-muted="action_type == 'document'">
                <field name="date"/>
                <field name="action_type" widget="badge"
                       decoration-success="action_type in ('email_sent', 'email_received', 'whatsapp_sent', 'whatsapp_received')"
                       decoration-info="action_type == 'call'"
                       decoration-warning="action_type == 'meeting'"
                       decoration-muted="action_type in ('note', 'document', 'other')"/>
                <field name="subject"/>
                <field name="user_id"/>
                <field name="partner_id" optional="show"/>
                <field name="attachment_count" string="Adjuntos" optional="show"/>
            </list>
        </field>
    </record>

    <!-- Standalone action (para poder acceder desde menú si se quiere) -->
    <record id="crm_communication_action" model="ir.actions.act_window">
        <field name="name">Historial de comunicaciones</field>
        <field name="res_model">crm.communication</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
    </record>

</odoo>
