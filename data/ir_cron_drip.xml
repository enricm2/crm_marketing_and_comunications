<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Envío a goteo: una ejecución = un email.
             Arranca DESACTIVADO a propósito; se activa desde la campaña con
             el botón "Iniciar goteo". El intervalo se ajusta ahí según cuántos
             envíos haya y hasta qué hora se quiera llegar. -->
        <record id="ir_cron_marketing_drip_send" model="ir.cron">
            <field name="name">Marketing Campaigns — Envío a goteo (1 email por ejecución)</field>
            <field name="model_id" ref="model_marketing_campaign"/>
            <field name="state">code</field>
            <field name="code">model._cron_drip_send()</field>
            <field name="interval_number">8</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="False"/>
            <field name="user_id" ref="base.user_root"/>
        </record>

        <!-- Generación de contenido personalizado con IA, por lotes.
             Arranca DESACTIVADO; lo activa "✨ Generar contenido IA (todos)"
             y se apaga solo cuando no quedan leads pendientes. Cada pasada
             procesa CONTENT_GEN_BATCH leads (una llamada a la IA por lead),
             así una lista larga termina sin depender de la petición web. -->
        <record id="ir_cron_marketing_content_gen" model="ir.cron">
            <field name="name">Marketing Campaigns — Generación de contenido IA (por lotes)</field>
            <field name="model_id" ref="model_marketing_campaign"/>
            <field name="state">code</field>
            <field name="code">model._cron_generate_content()</field>
            <field name="interval_number">2</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="False"/>
            <field name="user_id" ref="base.user_root"/>
        </record>

    </data>
</odoo>
